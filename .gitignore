# -----------------------------------------------------------------------------
# Atri Code — Production .gitignore
# -----------------------------------------------------------------------------

# Secrets and environment
.env
.env/
.env.*
!.env.example
!**/.env.example

# Node / Next.js
node_modules/
apps/frontend/node_modules/
.next/
apps/frontend/.next/
out/
apps/frontend/out/
dist/
apps/frontend/dist/
coverage/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
ENV/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# llama.cpp build outputs (keep source tracked)
runtime/llm/llama.cpp/build/
runtime/llm/llama.cpp/bin/
runtime/llm/llama.cpp/CMakeCache.txt
runtime/llm/llama.cpp/CMakeFiles/
runtime/llm/llama.cpp/cmake_install.cmake
runtime/llm/llama.cpp/CTestTestfile.cmake
runtime/llm/llama.cpp/compile_commands.json
runtime/llm/llama.cpp/models/*.gguf.out

# Models and large binary assets
*.gguf
*.ggml
*.bin

# Logs and runtime files
*.log
logs/
benchmark_reports/
*.pid
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
orchestrator.db
services/orchestrator/orchestrator.db*
runtime/state/*
!runtime/state/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
err.txt
out.txt

# Hardware detection output (generated per-machine)
runtime/llm/launch_config.json

# Local planning and research notes (keep local, do not push)
/.tmp_*
/CLAUDE_CODE_CLI_CLONE_IMPLEMENTATION_PLAN.md
/IMPLEMENTATION_TASK_CHECKLIST.md
/LLAMA_CPP_SETUP_STATUS.md
/REAL_LLM_TESTING_GUIDE.md
/WEB_SEARCH_AND_CLI_RESEARCH.md

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo
*~