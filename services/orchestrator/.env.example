# Atri Code Orchestrator — Environment Configuration
# Copy this to .env and adjust values as needed.

# ─── LLM (llama.cpp) ──────────────────────────────────────────────────────
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=secret
LLM_MODEL=local-model
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=4096
# 120s minimum; use 300 for large MoE models (Gemma 4 26B) on hybrid CPU/GPU setups
LLM_TIMEOUT_SECONDS=300

# ─── MCP ──────────────────────────────────────────────────────────────────
MCP_DEFAULT_TRANSPORT=stdio
MCP_TOOL_TIMEOUT_SECONDS=15
# Allow the agent to read/write hidden files (e.g. .gitignore, .env).
# Required when installed under ~/.local/share/atri/ — the allowed dir itself
# contains hidden path components (.local) which would otherwise block all access.
MCP_ALLOW_HIDDEN=true

# ─── Agent Loop ────────────────────────────────────────────────────────────
# thinking_mode: off | tool_calls_off | always
# tool_calls_off = think on final answer only (recommended for Gemma 4 E2B)
AGENT_MAX_TURNS=10
AGENT_MAX_TOOL_CALLS_PER_TURN=3
AGENT_ENABLE_TOOL_USE=true
AGENT_THINKING_MODE=tool_calls_off
AGENT_STREAM_RESPONSES=false

# ─── Auth ─────────────────────────────────────────────────────────────────
# Leave blank for anonymous mode (local dev). Set in production.
ORCHESTRATOR_JWT_SECRET=
ORCHESTRATOR_API_KEY=
# Leave ORCHESTRATOR_ADMIN_API_KEY blank for local dev. Required to override prompt_profile via API.
ORCHESTRATOR_ADMIN_API_KEY=

# ─── Web Search ───────────────────────────────────────────────────────────
TAVILY_API_KEY=                   # Primary web search provider (get free key at tavily.com)
BRAVE_SEARCH_API_KEY=             # Alternative search provider (optional)

# ─── Rate Limiting / Redis ─────────────────────────────────────────────────
REDIS_URL=                        # e.g. redis://localhost:6379 — optional in local dev

# ─── Context Management ────────────────────────────────────────────────────
AGENT_IDLE_COMPACT_THRESHOLD_PCT=0.70   # Compact context at 70% usage (before 80% hard limit)
AGENT_IDLE_COMPACT_MIN_TURNS=3          # Skip compaction in very short sessions
MCP_TOOL_CACHE_TTL_SECONDS=3600         # Cache MCP tool definitions for 1 hour

# ─── Persistence ──────────────────────────────────────────────────────────
ORCHESTRATOR_DATABASE_URL=sqlite:///runtime/state/orchestrator.db
ORCHESTRATOR_ENABLE_PERSISTENCE=true

# ─── Observability ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_OBSERVABILITY=true
# agent-v3 for the 2B E2B decoder (default); agent-v3-26b for the 26B MoE; general-purpose for chat-only.
# The CLI auto-selects this per model at launch — this value is the fallback for direct uvicorn runs.
PROMPT_POLICY_DEFAULT_PROFILE=agent-v3
