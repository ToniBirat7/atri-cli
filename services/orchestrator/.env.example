# Atri Code Orchestrator — Environment Configuration
# Copy this to .env and adjust values as needed.

# ─── LLM (llama.cpp) ──────────────────────────────────────────────────────
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=secret
LLM_MODEL=local-model
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# ─── Model paths (set by install.sh — override if model is elsewhere) ─────
# ATRI_MODEL_DIR=/path/to/your/gemma4-26b
# ATRI_MMPROJ_PATH=/path/to/your/gemma4-26b/mmproj-BF16.gguf

# ─── MCP ──────────────────────────────────────────────────────────────────
MCP_DEFAULT_TRANSPORT=stdio
MCP_TOOL_TIMEOUT_SECONDS=15
# Allow the agent to read/write hidden files (e.g. .gitignore, .env).
# Required when installed under ~/.local/share/atri/ — the allowed dir itself
# contains hidden path components (.local) which would otherwise block all access.
MCP_ALLOW_HIDDEN=true

# ─── Agent Loop ────────────────────────────────────────────────────────────
# thinking_mode: off | tool_calls_off | always
# tool_calls_off = think on final answer only (recommended for Gemma 4 26B A4B)
AGENT_MAX_TURNS=10
AGENT_MAX_TOOL_CALLS_PER_TURN=3
AGENT_ENABLE_TOOL_USE=true
AGENT_THINKING_MODE=tool_calls_off
AGENT_STREAM_RESPONSES=false

# ─── Persistence ──────────────────────────────────────────────────────────
ORCHESTRATOR_DATABASE_URL=sqlite:///runtime/state/orchestrator.db
ORCHESTRATOR_ENABLE_PERSISTENCE=true

# ─── Observability ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_OBSERVABILITY=true
PROMPT_POLICY_DEFAULT_PROFILE=agent-v3-26b
